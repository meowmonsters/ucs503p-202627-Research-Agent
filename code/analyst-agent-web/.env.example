# Copy to .env (cp .env.example .env) to override. Never commit .env.
#
# URL of the Go backend (see ../analyst-agent-go) — no trailing path.
#   local development:  http://localhost:8080   (the default if unset)
#   deployed:           https://<your-backend>.onrender.com
#
# Vite reads this when the site is BUILT (npm run dev / npm run build), not
# when it is served. On Render, set it as an environment variable on the
# static site and redeploy after changing it.
VITE_API_URL=http://localhost:8080
