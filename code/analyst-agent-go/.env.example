# Copy to .env and load it before running the server:
#   cp .env.example .env
#   set -a; source .env; set +a; go run ./cmd/server
#
# On Render, don't use a file — set these in the service's Environment tab.
# Every variable except GEMINI_API_KEY is optional.

# --- AI model ---------------------------------------------------------------

# Google Gemini key (free at https://aistudio.google.com/apikey). Without it
# the agent still runs, but writes a plain report built from raw tool data
# instead of an AI-written one.
GEMINI_API_KEY=your-gemini-api-key-here

# Which Gemini model to call. Google retires models on a schedule (the
# gemini-2.0-* models stopped working on 1 June 2026, which makes every
# report fall back to the data-only version). If reports say "needs the AI
# model", check the current names at
# https://ai.google.dev/gemini-api/docs/deprecations and set one here.
# Leave blank to use the built-in default.
GEMINI_MODEL=

# Backup LLM, used once if the Gemini call fails (https://openrouter.ai).
OPENROUTER_API_KEY=
# Its model id, e.g. google/gemini-3.5-flash-lite (blank = built-in default;
# check the id exists on openrouter.ai/models).
OPENROUTER_MODEL=

# --- Data sources (all optional; each falls back to a free scrape) ----------

# Preferred price source (free tier, no card: https://twelvedata.com).
# Falls back to Yahoo Finance, then Screener.in for Indian tickers.
TWELVEDATA_API_KEY=

# Preferred search/news source (https://exa.ai). Falls back to
# DuckDuckGo / Google News RSS.
EXA_API_KEY=

# --- Server -----------------------------------------------------------------

# Port to listen on. Render sets this itself; leave it blank there.
PORT=8080

# Which frontend may call the API. Blank means "any website" — fine locally,
# but in production set it to your deployed frontend, e.g.
#   ALLOWED_ORIGIN=https://researchagent-web.onrender.com
# Several origins can be comma-separated. A trailing slash is ignored.
ALLOWED_ORIGIN=

# Max research runs in flight at once (default 4). Extra requests get a quick
# "server busy" (503) instead of piling up and burning API quota.
MAX_CONCURRENT_RUNS=

# How long, in seconds, one run may keep researching before it writes the
# report from what it has (default 90).
RUN_BUDGET_SECONDS=

# --- Demo only --------------------------------------------------------------

# Set to 1 to allow hard-coded sample figures for AAPL / INFY.NS when every
# live source is down. They are NOT live data (labelled "Sample data (not
# live)"). Leave blank for real use.
ALLOW_SAMPLE_DATA=
