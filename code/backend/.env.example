# Copy to .env and export/source it before running the server.

# Required — the agent loop calls Gemini directly.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — used as a backup if the direct Gemini call fails.
OPENROUTER_API_KEY=

# Optional — preferred financial data source if set (free tier, no card
# required: https://twelvedata.com). Falls back to Yahoo/Screener.in/mock
# data if unset or if the call fails.
TWELVEDATA_API_KEY=

# Optional — preferred search/news source if set. Falls back to
# DuckDuckGo/Google News RSS if unset or if the call fails.
EXA_API_KEY=
